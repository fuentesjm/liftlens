# Copy this file to .env and fill in real values. Never commit .env.
# Every setting is optional: defaults are used if a line is missing.

# --- LLM (feedback writer + plan generator) ---
# Free key: https://aistudio.google.com -> Get API key
# Without a key the app still runs and uses template text instead.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash
# LLM_TIMEOUT_SECONDS=30

# --- API server ---
# LIFTLENS_MODEL_PATH=models/pose_landmarker_full.task
# LIFTLENS_DATA_DIR=data
# LIFTLENS_MAX_UPLOAD_MB=200
# LIFTLENS_CORS_ORIGINS=http://localhost:3000
